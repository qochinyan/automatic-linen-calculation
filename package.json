{
  "name": "automatic-linen-calculation",
  "version": "1.0.0",
  "description": "Backend service that receives reservation events and keeps the linen (sheets, towels, bathmats, handtowels, dishtowels, sofa beds) of open Main Cleaning tasks up to date. React + TypeScript front end for viewing tasks, linen, and recalculation history.",
  "scripts": {
    "seed": "tsx src/seed/seed.ts",
    "start": "tsx src/infrastructure/http/server.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --passWithNoTests"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qochinyan/automatic-linen-calculation.git"
  },
  "keywords": [],
